{
  "appId": "io.github.hungaihello.nhaminh",
  "appName": "Nhà Mình",
  "webDir": "www",
  "backgroundColor": "#f6f4ef",
  "server": {
    "url": "https://hung-aihello.github.io/FamilyPosition/",
    "errorPath": "offline.html"
  },
  "android": {
    "useLegacyBridge": true
  },
